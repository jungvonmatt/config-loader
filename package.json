{
  "name": "@jungvonmatt/config-loader",
  "version": "0.6.2",
  "description": "Load config from files & environment & ask for missing values",
  "repository": "git@github.com:jungvonmatt/config-loader.git",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "vp test dev",
    "lint": "vp lint . && vp fmt --check .",
    "lint:fix": "automd && vp lint . --fix && vp fmt .",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vp test run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "eslint-config-unjs": "^0.6.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "packageManager": "pnpm@10.7.0",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.66.0",
    "c12": "4.0.0-beta.5",
    "defu": "^6.1.7",
    "destr": "^2.0.5",
    "enquirer": "^2.4.1",
    "find-up": "^8.0.0",
    "jiti": "^2.7.0",
    "klona": "^2.0.6",
    "pathe": "^2.0.3",
    "scule": "^1.3.0",
    "std-env": "^4.1.0",
    "type-fest": "^5.6.0"
  }
}